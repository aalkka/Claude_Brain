#!/bin/sh
# 외부뇌 pre-commit: secret 차단 + sensitive unstage + frontmatter lint(경고)
# 스펙: 제작가이드 §15-1

fail=0
# 0. 속성 자동 칸 — 커밋에 든 노트의 updated = 파일 수정 날짜(props-sync.py · 사용자 10-30 · 고친 파일은 다시 git add).
#    실패해도 커밋은 막지 않는다(파이썬이 없거나 대본이 깨져도 아래 검사는 그대로).
py -3 3_시스템/props-sync.py --staged >/dev/null 2>&1 || true
# 0.5 묶음 검사(11-06 시스템 재기 §3-2·6) — 아래 sh 검사와 같은 판정을 `git cat-file --batch` 한 번으로 한다
#    (sh 검사 = 파일마다 git 5~6번 · 파일당 0.36~1.1초). 끝 코드 0 = 통과 · 3 = 막음.
#    그 밖(파이썬 없음·대본 깨짐·예외)은 아래 sh 검사가 처음부터 다시 한다 — 비밀·민감 검사가 빠지는 길은 없다.
py -3 3_시스템/hooks/pre-commit-scan.py
case $? in 0) exit 0 ;; 3) exit 1 ;; esac
# C1: quotepath=false → 한글 경로 옥탈인용 방지(안 하면 [ -f "$f" ] 실패 → 전 볼트 스킵 = 게이트 무력화).
# R 포함: 이름을 바꾸며 민감 표시·키가 든 노트가 검사를 건너뛰었다(11-02 `자격-카드.md` · 격리 재현).
staged=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)

# 스테이지에서 내린다. 다른 세션의 git 이 index.lock 을 쥐면 실패하므로 몇 번 더 하고, 끝내 못 내리면 1(커밋을 막는다).
# 실패를 안 봐서 민감 노트가 커밋에 들었다(11-05 격리 재현 · 볼트는 세션 여럿이 턴마다 git add -A).
unstage() {
	for _try in 1 2 3 4 5; do
		if git rev-parse --verify HEAD >/dev/null 2>&1; then
			git reset -q HEAD -- "$1" 2>/dev/null && return 0
		else
			git rm --cached -q -- "$1" 2>/dev/null && return 0
		fi
		sleep 1
	done
	return 1
}

IFS='
'   # 공백 포함 파일명 안전(개행만 구분자)
for f in $staged; do
	# 스테이지 판이 기준 — 작업 파일이 옮겨졌거나 지워져도 커밋에는 든다
	git cat-file -e ":$f" 2>/dev/null || continue

	# 1. secret 스캔 — 히트 시 커밋 차단
	#    실제 키 형태: sk-계열(하이픈 허용: sk-ant-/sk-proj-/sk-live-)·ghp_·AWS AKIA·PEM.
	#    단어경계+16자+로 task-/짧은 CSS클래스 오탐 제외. (짧은 toy 'sk-test123'은 의도적 비매칭 — 실제 키는 40자+)
	if git show ":$f" | grep -Eq '(\bsk-[A-Za-z0-9_-]{16,}|\bghp_[A-Za-z0-9]{16,}|\bAKIA[0-9A-Z]{16}|-----BEGIN[^-]*PRIVATE KEY-----)'; then
		echo "❌ secret 의심: $f (커밋 차단)"
		fail=1
	fi

	case "$f" in
	*.md)
		# 3. sensitive:true → unstage (push 제외)
		#    frontmatter 필드만: 값 뒤 줄끝 앵커로 문서 산문("sensitive: true 시…") 오탐 제외
		if git show ":$f" | grep -Eq '^sensitive:[[:space:]]*true[[:space:]]*$'; then
			if unstage "$f"; then
				echo "⚠ sensitive 노트 unstage: $f (push 제외)"
			else
				echo "❌ sensitive 노트를 못 내림(잠금?): $f (커밋 차단)"
				fail=1
			fi
			continue   # M4: unstage 후 git show 실패 → frontmatter 오경고 방지
		fi
		# 2. frontmatter 검사. 지식노트(2_지식)=차단(스키마 깨진 노트=실오류, Stop훅 백스톱).
		#    사용자 저작물(1_수집)=경고만(무수정 원칙). MOC 등재는 Stop훅 담당(커밋 좌초 방지).
		case "$f" in
		2_지식/*)
			first=$(git show ":$f" 2>/dev/null | head -n 1)
			if [ "$first" != "---" ]; then
				echo "❌ frontmatter 없음: $f (커밋 차단)"
				fail=1
			fi
			# links: YAML 유효성 — 위키링크 무따옴표 [[x]]/[[[x]]]=파싱오류(Obsidian 적색). 따옴표 배열 "[[x]]"만 허용.
			lk=$(git show ":$f" 2>/dev/null | grep -E '^links:')
			if [ -n "$lk" ] && printf '%s' "$lk" | grep -q '\[\[' && ! printf '%s' "$lk" | grep -q '"\[\['; then
				echo "❌ links 프론트매터 깨짐(따옴표 배열 \"[[x]]\" 필요): $f (커밋 차단)"
				fail=1
			fi
			;;
		1_수집/*)
			first=$(git show ":$f" 2>/dev/null | head -n 1)
			if [ "$first" != "---" ]; then
				echo "⚠ frontmatter 없음: $f (경고)"
			fi
			;;
		esac
		;;
	esac
done

# 마지막 확인 — 내린 사이 다른 세션의 git add -A 가 다시 올린 민감 노트(이 뒤 커밋이 스테이지를 읽기까지의 틈은 못 막는다)
for f in $(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR -- '*.md'); do
	if git show ":$f" 2>/dev/null | grep -Eq '^sensitive:[[:space:]]*true[[:space:]]*$'; then
		echo "❌ sensitive 노트가 다시 스테이지됨: $f (커밋 차단)"
		fail=1
	fi
done

[ "$fail" -eq 1 ] && exit 1
exit 0
