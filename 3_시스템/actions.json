{
  "schema": 1,
  "_설명": "외부뇌가 할 수 있는 일(행위) — 코어 몫. 모듈 몫은 각 module.json 의 contributes.actions. 실행 = py -3 3_시스템/brain.py run <id> [인자] · 목록 = brain.py list. run 의 {py} = brain.py 를 돌린 파이썬 · {by} = 누가 · {이름} = 인자. risk: read(읽기) · write(볼트 쓰기) · send(밖으로 보냄 — --yes 필요) · usage(Claude 사용량 — --yes 필요). empty = 출력에 이 무늬(정규식)가 있으면 «받은 것 없음» — 장부에 짧게만(사용자 10-30).",
  "actions": [
    {"id": "search", "name": "볼트에서 찾기", "risk": "read", "run": ["{py}", "3_시스템/search.py", "--q", "{q}", "--k", "8"], "args": [{"name": "q", "label": "찾을 말"}]},
    {"id": "search.reindex", "name": "찾기 색인 다시", "risk": "write", "run": ["{py}", "3_시스템/search.py", "--reindex"]},
    {"id": "index.sources", "name": "원본 색인 다시(1_수집)", "risk": "write", "run": ["{py}", "3_시스템/ingest.py"], "rest": {"name": "paths", "label": "원본 경로(비우면 전부)"}},
    {"id": "schedule.refresh", "name": "일정 다시 만들기", "risk": "write", "run": ["{py}", "3_시스템/schedule.py", "build"]},
    {"id": "schedule.holidays", "name": "공휴일 표 다시 받기(구글 대한민국 공휴일 달력)", "risk": "write", "run": ["{py}", "3_시스템/holidays.py"]},
    {"id": "schedule.week", "name": "이번 주 일정", "risk": "read", "run": ["{py}", "3_시스템/schedule.py", "week", "7"]},
    {"id": "collect.lms", "name": "LMS 수집 지금", "optional": true, "risk": "write", "run": ["{py}", "3_시스템/lms-auto.py"], "rest": {"name": "opts", "label": "lms-auto 선택(--dry · --sleep-after)"}, "empty": "^받은 것: LMS 요약 0 · 웹 새 글 0"},
    {"id": "collect.lms.wake", "name": "LMS 수집 전 깨움 표시·크롬 띄우기", "optional": true, "risk": "write", "run": ["{py}", "3_시스템/lms-auto.py", "--mark-wake"]},
    {"id": "collect.web", "name": "웹 공지 수집 지금", "optional": true, "risk": "write", "run": ["{py}", "3_시스템/web-collect.py"]},
    {"id": "files.move", "name": "옮기기·이름 바꾸기", "risk": "write", "run": ["{py}", "3_시스템/fileops.py", "--by", "{by}", "mv", "{src}", "{dst}", "--why", "{why}"], "args": [{"name": "src", "label": "원래 자리"}, {"name": "dst", "label": "새 자리"}, {"name": "why", "label": "까닭"}]},
    {"id": "files.trash", "name": "휴지통으로", "risk": "write", "run": ["{py}", "3_시스템/fileops.py", "--by", "{by}", "rm", "{path}", "--why", "{why}"], "args": [{"name": "path", "label": "경로"}, {"name": "why", "label": "까닭"}], "rest": {"name": "opts", "label": "선택(--user-asked = 1_수집 원본 · 사람이 시켰을 때만)"}},
    {"id": "files.restore", "name": "휴지통에서 되살리기", "risk": "write", "run": ["{py}", "3_시스템/fileops.py", "--by", "{by}", "restore", "{key}"], "args": [{"name": "key", "label": "장부 id 또는 휴지통 경로"}]},
    {"id": "files.undo", "name": "행위 되돌리기", "risk": "write", "run": ["{py}", "3_시스템/fileops.py", "--by", "{by}", "undo", "{key}"], "args": [{"name": "key", "label": "장부 id"}]},
    {"id": "ledger.log", "name": "장부 최근", "risk": "read", "run": ["{py}", "3_시스템/fileops.py", "log", "-n", "20"]},
    {"id": "trash.list", "name": "휴지통 보기", "risk": "read", "run": ["{py}", "3_시스템/fileops.py", "trash"]},
    {"id": "inbox.list", "name": "받은함 보기", "risk": "read", "builtin": "inbox"},
    {"id": "inbox.suggest", "name": "받은함 분류 제안(옮기지 않음)", "risk": "read", "run": ["{py}", "3_시스템/inbox.py"]},
    {"id": "inbox.sort", "name": "받은함 정리(확실한 것만 · 재료는 원본 층에 안 들임)", "risk": "write", "run": ["{py}", "3_시스템/inbox.py", "--by", "{by}", "--apply"]},
    {"id": "inbox.do", "name": "받은함 항목 하나를 제안대로", "risk": "write", "run": ["{py}", "3_시스템/inbox.py", "--by", "{by}", "--do", "{name}"], "args": [{"name": "name", "label": "받은함 항목 이름"}]},
    {"id": "cleanup.candidates", "name": "정리 후보 보기(지우지 않음 · 계획 파일)", "risk": "read", "run": ["{py}", "3_시스템/cleanup.py"]},
    {"id": "work.status", "name": "작업 폴더 상태(과제마다 끝남·제출본·멈춤)", "risk": "read", "run": ["{py}", "3_시스템/work.py"]},
    {"id": "work.plan", "name": "끝난 작업 정리 계획(결과물 보관 + 나머지 휴지통 · 학교는 PDF 만 · 지우지 않음 · 승인 뒤 적용)", "risk": "read", "run": ["{py}", "3_시스템/work.py", "plan"]},
    {"id": "outside.list", "name": "볼트 밖 후보(내려받기·바탕화면의 볼트에 없는 문서 · 옮기지 않음)", "risk": "read", "run": ["{py}", "3_시스템/outside.py"]},
    {"id": "outside.take", "name": "볼트 밖 후보를 받은함으로 복사", "risk": "write", "run": ["{py}", "3_시스템/outside.py", "take", "{key}", "--by", "{by}"], "args": [{"name": "key", "label": "후보 이름 또는 열쇠"}]},
    {"id": "outside.hide", "name": "볼트 밖 후보를 목록에서 빼기", "risk": "write", "run": ["{py}", "3_시스템/outside.py", "hide", "{key}"], "args": [{"name": "key", "label": "후보 이름 또는 열쇠"}]},
    {"id": "follow.run", "name": "바깥 변화 따라가기(옵시디언 밖에서 옮기거나 지운 것 뒤처리)", "risk": "write", "run": ["{py}", "3_시스템/follow.py"], "empty": "^바뀐 것 없음"},
    {"id": "follow.accept", "name": "한꺼번에 사라진 것을 지움으로 받아들이기", "risk": "write", "run": ["{py}", "3_시스템/follow.py", "--accept"]},
    {"id": "follow.refetch", "name": "사라진 LMS 원본 다음 수집 때 다시 받기", "risk": "write", "run": ["{py}", "3_시스템/follow.py", "refetch", "{path}"], "args": [{"name": "path", "label": "사라진 원본 경로"}]},
    {"id": "follow.keep", "name": "사라진 것 그대로 두기(답 기다림에서 뺌)", "risk": "write", "run": ["{py}", "3_시스템/follow.py", "keep", "{path}"], "args": [{"name": "path", "label": "사라진 원본 경로"}]},
    {"id": "topic.card", "name": "주제 카드(마감·작업·원본·노트·지난 대화)", "risk": "read", "run": ["{py}", "3_시스템/topic.py", "card", "{topic}"], "args": [{"name": "topic", "label": "주제 이름·별칭 또는 경로"}]}
  ]
}
