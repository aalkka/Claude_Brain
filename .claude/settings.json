{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/3_시스템/hooks/session-start.ps1\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/3_시스템/hooks/session-notice.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/3_시스템/hooks/core-gate-front.py\"; if [ -f \"$f\" ]; then py -3 -S \"$f\"; r=$?; if [ $r -eq 0 ] || [ $r -eq 2 ] || [ $r -eq 3 ]; then exit $r; fi; fi; powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/3_시스템/hooks/core-gate.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/3_시스템/mdtable.py\" hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/3_시스템/hooks/permission-probe.ps1\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/3_시스템/hooks/session-end.ps1\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/3_시스템/hooks/loop-pin.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/3_시스템/session-stub.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/3_시스템/hooks/stop-check.py\" || powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/3_시스템/hooks/stop-check.ps1\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/3_시스템/hooks/idle-save.py\"",
            "asyncRewake": true,
            "timeout": 3300
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "py -3 \"${CLAUDE_PROJECT_DIR:-.}/3_시스템/hooks/statusline.py\""
  }
}
